{
    "name": "cycle/transaction",
    "description": "Transaction abstraction for Cycle ORM: run DBAL operations and a scoped Entity Manager within a single database transaction.",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.20",
        "cycle/orm": "^2.18"
    },
    "require-dev": {
        "buggregator/trap": "^1.16",
        "cycle/skills": "1.x-dev",
        "illuminate/container": "^11 || ^12 || ^13",
        "illuminate/support": "^11 || ^12 || ^13",
        "infection/infection": ">=0.32.6",
        "llm/skills": "^1.7",
        "spiral/boot": "^3.12",
        "spiral/cycle-bridge": "^2.13",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.26",
        "vimeo/psalm": "^7",
        "yiisoft/di": "^1.3"
    },
    "suggest": {
        "spiral/cycle-bridge": "Provides integration with the Spiral Framework via TransactionBootloader",
        "wayofdev/laravel-cycle-orm-adapter": "Provides Cycle ORM integration for Laravel (TransactionServiceProvider)",
        "yiisoft/yii-cycle": "Provides Cycle ORM integration for the Yii Framework"
    },
    "autoload": {
        "psr-4": {
            "Cycle\\Transaction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Transaction\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:acceptance": "testo --suite=Acceptance",
        "test:integration": "testo --suite=Acceptance",
        "test:no-driver": "testo --group=!driver",
        "test:sqlite": "testo --suite=Acceptance --group=driver-sqlite",
        "test:mysql": "testo --suite=Acceptance --group=driver-mysql",
        "test:postgres": "testo --suite=Acceptance --group=driver-postgres",
        "test:sqlserver": "testo --suite=Acceptance --group=driver-sqlserver",
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "testo --group=!driver-mysql --group=!driver-postgres --group=!driver-sqlserver --coverage"
        ],
        "psalm": "psalm",
        "infection": "infection",
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0 --min-msi=50"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cycle\\Transaction\\Bridge\\Laravel\\Providers\\TransactionServiceProvider"
            ]
        },
        "config-plugin": {
            "di": "src/Bridge/Yii3/config/di.php"
        },
        "spiral": {
            "bootloaders": [
                "Cycle\\Transaction\\Bridge\\Spiral\\Bootloader\\TransactionBootloader"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "llm/skills": true
        }
    }
}
